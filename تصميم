* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Tajawal', sans-serif;
}

body {
    background-color: #f4f7fe;
    color: #333;
    line-height: 1.6;
}

/* Navbar */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #1e293b;
    padding: 15px 5%;
    color: white;
}

.navbar .logo {
    font-size: 1.4rem;
    font-weight: bold;
    color: #38bdf8;
}

.nav-links {
    list-style: none;
    display: flex;
    gap: 20px;
}

.nav-links a {
    color: white;
    text-decoration: none;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #38bdf8;
}

/* Hero Section */
.hero {
    background: linear-gradient(135deg, #0f172a, #2563eb);
    color: white;
    text-align: center;
    padding: 80px 20px;
}

.hero h1 {
    font-size: 2.5rem;
    margin-bottom: 10px;
}

.btn-primary {
    display: inline-block;
    margin-top: 20px;
    padding: 12px 25px;
    background-color: #38bdf8;
    color: #0f172a;
    font-weight: bold;
    border-radius: 8px;
    text-decoration: none;
    transition: 0.3s;
}

.btn-primary:hover {
    background-color: #0284c7;
    color: white;
}

/* Containers & Grid */
.container {
    max-width: 1100px;
    margin: 40px auto;
    padding: 0 20px;
}

.section-title {
    text-align: center;
    margin-bottom: 30px;
    font-size: 1.8rem;
    color: #0f172a;
}

.cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
}

.card {
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    border: 1px solid #e2e8f0;
    text-align: center;
}

.card h3 {
    margin-bottom: 10px;
    color: #2563eb;
}

.btn-card {
    margin-top: 15px;
    padding: 10px 20px;
    background-color: #1e293b;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
}

/* Quiz Section */
.quiz-box {
    background: white;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
}

.question {
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 1px solid #edf2f7;
}

.btn-submit {
    background-color: #16a34a;
    color: white;
    padding: 12px 30px;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    cursor: pointer;
    font-weight: bold;
}

.result-box {
    margin-top: 20px;
    font-size: 1.2rem;
    font-weight: bold;
}

footer {
    text-align: center;
    padding: 20px;
    background-color: #0f172a;
    color: #94a3b8;
    margin-top: 50px;
}
